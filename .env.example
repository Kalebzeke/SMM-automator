# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (single shared password gate for /services, /comments,
# /providers, /telegram pages)
ADMIN_PANEL_PASSWORD=

# Shared secret for /api/cron/* routes triggered by Supabase pg_cron
CRON_SECRET=

# --- Telegram publishing ---

# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`).
# Encrypts Telegram bot tokens at rest in the telegram_bots table.
TELEGRAM_TOKEN_ENCRYPTION_KEY=

# Shared secret Telegram must send back in the
# X-Telegram-Bot-Api-Secret-Token header. Generate any random string and
# pass the same value when calling setWebhook (see docs/telegram-publishing.md).
TELEGRAM_WEBHOOK_SECRET=

# --- Reserved for optional Phase 2 (MTProto channel creation) ---
# Not required for Bot API publishing.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
